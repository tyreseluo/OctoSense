    {
      "id": "reference",
      "crate": "octosense-reference",
      "source": { "path": "apps/reference" },
      "module": "octosense_reference::REFERENCE_MODULE",
      "bin": "octosense-reference",
      "default_features": true,
      "crate_features": [],
      "implies": [],
      "hosting": { "macos": "module", "windows": "module", "linux": "module", "android": "module", "ios": "module", "ohos": "module" },
      "shells": { "desktop": "opt-in", "phone": "mobile-apps" },
      "native_mobile": "always",
      "sandbox": { "network": "none", "processes": false },
      "storage": { "accounts": false, "agent_workspace": "none", "external": [] },
