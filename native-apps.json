      "module": "rinx::module::RINX_MODULE",
      "bin": null,
      "default_features": false,
      "crate_features": ["octosense-module"],
      "implies": ["octos-core"],
      "hosting": { "macos": "module", "windows": "module", "linux": "module", "android": "module", "ios": "module", "ohos": "module" },
      "shells": { "desktop": "default", "phone": "default" },
      "native_mobile": "feature",
      "sandbox": { "network": "any", "processes": false },
      "storage": { "accounts": true, "agent_workspace": "account", "external": [] },
      "agent": {
        "octos": ["octos.session.open", "octos.session.history", "octos.turn.start", "octos.turn.interrupt"],
